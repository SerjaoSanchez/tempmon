#!/usr/bin/env python3
"""tempmon - CPU, GPU and SSD temperature monitor for the terminal.

Usage:
  tempmon                 refresh every second (or the interval set in the config file)
  tempmon 2               refresh every 2 seconds
  tempmon --log           log the session to CSV in the folder set in the config file
  tempmon -o game.csv     log the session to the given file
  tempmon --config        print the config file path
Quit: q or Ctrl+C

CPU: Intel (coretemp) and AMD Ryzen (k10temp / zenpower)
GPU: NVIDIA (nvidia-smi) and AMD Radeon (amdgpu)
SSD: NVMe
"""
import argparse, copy, csv, glob, os, re, select, shutil, subprocess, sys, time
from collections import deque
from datetime import datetime

try:                                  # Python 3.11+
    import tomllib
except ModuleNotFoundError:           # Python 3.8-3.10: python3-tomli package
    try:
        import tomli as tomllib
    except ModuleNotFoundError:
        tomllib = None

VERSION = "1.1.0"

# ───────────────────────── configuration ─────────────────────────
