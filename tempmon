}


def same_type(default, value):
    if isinstance(default, bool):
        return isinstance(value, bool)
    if isinstance(default, (int, float)):
        return isinstance(value, (int, float)) and not isinstance(value, bool)
    return isinstance(value, type(default))


def merge(base, user, prefix=""):
    """Apply the user's config over the defaults, skipping invalid values."""
    problems = []
    for k, v in user.items():
        name = prefix + k
        if k not in base:
            problems.append(f"unknown key '{name}'")
        elif isinstance(base[k], dict):
            if isinstance(v, dict):
                problems += merge(base[k], v, name + ".")
            else:
                problems.append(f"'{name}' should be a section")
        elif not same_type(base[k], v):
            problems.append(f"'{name}' has an invalid type")
        elif prefix == "colors." and not 0 <= v <= 255:
            problems.append(f"'{name}' out of 0-255")
        else:
            base[k] = v
    return problems


def load_config():
    if not os.path.exists(CONFIG_PATH):
        os.makedirs(os.path.dirname(CONFIG_PATH), exist_ok=True)
        with open(CONFIG_PATH, "w") as f:
            f.write(DEFAULT_CONFIG)
    cfg = copy.deepcopy(DEFAULTS)
    if tomllib is None:
        return cfg, "config ignored: install python3-tomli (Python < 3.11)"
    try:
        with open(CONFIG_PATH, "rb") as f:
            user = tomllib.load(f)
    except Exception as e:
        return cfg, f"config error, using defaults: {e}"
    problems = merge(cfg, user)
    return cfg, ("config: " + "; ".join(problems) + " (ignored)") if problems else None


# ───────────────────────── colors and drawing ─────────────────────────
R, B, DIM = "\033[0m", "\033[1m", "\033[2m"
ANSI = re.compile(r"\033\[[0-9;?]*[a-zA-Z]")


def fg(n):
    return f"\033[38;5;{int(n)}m"


GRAY, DARK = fg(244), fg(237)
C = {}      # theme colors, filled by setup()
LIM = {}    # temperature thresholds


def setup(cfg):
    C.update({k: fg(v) for k, v in cfg["colors"].items()})
    LIM.update(cfg["thresholds"])


def clamp(x, lo=0.0, hi=1.0):
    return max(lo, min(hi, x))


def temp_color(t, kind="cpu"):
    if t is None:
        return GRAY
    warn, crit = LIM[f"{kind}_warn"], LIM[f"{kind}_critical"]
    if t >= crit:
        return C["critical"]
    if t >= warn:
        return C["hot"]
    if t >= warn - 15:
        return C["warm"]
    return C["normal"]


def tcolor(kind):
    return lambda t: temp_color(t, kind)


def load_color(p):
    return C["critical"] if p >= 90 else C["hot"] if p >= 70 else C["warm"] if p >= 40 else C["normal"]


EIGHTHS = " ▏▎▍▌▋▊▉"
SPARK = "▁▂▃▄▅▆▇█"


def bar(value, maximum, width, colorfn):
    """Gradient bar: each cell gets the color of the value it represents."""
    if width <= 0:
        return ""
    cells = clamp((value or 0) / maximum if maximum else 0) * width
    full, rem = int(cells), int((cells - int(cells)) * 8)
    out = []
    for i in range(width):
        c = colorfn((i + 0.5) / width * maximum)
        if i < full:
            out.append(c + "█")
        elif i == full and rem:
            out.append(c + EIGHTHS[rem])
        else:
            out.append(DARK + "─")
    return "".join(out) + R


def sparkline(hist, width, colorfn, lo=30, hi=95):
    vals = list(hist)[-width:]
    s = "".join(colorfn(v) + SPARK[int(clamp((v - lo) / (hi - lo)) * 7.999)] for v in vals)
    return DARK + "·" * (width - len(vals)) + s + R


def vlen(s):
    return len(ANSI.sub("", s))


def pad(s, w):
    if vlen(s) > w:  # truncate without breaking color codes
        out, vis = [], 0
        for tok in re.split(r"(\033\[[0-9;?]*[a-zA-Z])", s):
            if tok.startswith("\033"):
                out.append(tok)
            else:
                out.append(tok[: max(0, w - vis)])
                vis += len(out[-1])
        return "".join(out) + R
    return s + " " * (w - vlen(s))


def panel(title, lines, w, color):
    inner = w - 4
    top = f"{color}╭─ {R}{B}{title}{R}{color} " + "─" * max(0, w - 5 - len(title)) + f"╮{R}"
    body = [f"{color}│{R} {pad(l, inner)} {color}│{R}" for l in lines]
    return [top] + body + [f"{color}╰" + "─" * (w - 2) + f"╯{R}"]


# ───────────────────────── statistics and throttling ─────────────────────────
class Stat:
    def __init__(self):
        self.n, self.total, self.peak = 0, 0.0, None
        self.hist = deque(maxlen=300)

    def add(self, v):
        if v is None:
            return
        self.n += 1
        self.total += v
        self.peak = v if self.peak is None else max(self.peak, v)
        self.hist.append(v)

    @property
    def avg(self):
        return self.total / self.n if self.n else None


class Throttle:
    """Tracks whether throttling is happening now and how often / how long it happened this session."""

    def __init__(self):
        self.active, self.events, self.secs, self.available = False, 0, 0.0, True

    def update(self, active, secs):
        if active is None:
            self.available = False
            return
        if active and not self.active:
            self.events += 1
        if active:
            self.secs += secs
        self.active = active

    def line(self):
        if not self.available:
            return f"{GRAY}throttling: not available{R}"
        if self.active:
            return f"{C['critical']}{B}▲ THROTTLING: clock reduced due to heat{R}"
        if self.events:
            return f"{C['hot']}▲ throttled {self.events}x this session ({self.secs:.0f}s){R}"
        return f"{GRAY}✓ no thermal throttling{R}"

    def summary(self):
        if not self.available:
            return "not available"
        return f"{self.events}x ({self.secs:.0f}s)" if self.events else "none"


# ───────────────────────── sensor reading ─────────────────────────
def readf(p):
    try:
        with open(p) as f:
            return f.read().strip()
    except OSError:
        return None


def readint(p):
    v = readf(p)
    try:
        return int(v) if v is not None else None
    except ValueError:
        return None


def hwmons(name):
    return [d for d in sorted(glob.glob("/sys/class/hwmon/hwmon*")) if readf(f"{d}/name") == name]


def cpu_name():
    for line in (readf("/proc/cpuinfo") or "").splitlines():
        if line.startswith("model name"):
            n = re.sub(r"\((R|TM)\)|CPU @.*|\d+-Core Processor|Processor", "", line.split(":", 1)[1])
            return re.sub(r"\s+", " ", n).strip()
    return "CPU"


def read_cpu_temps(hw):
    out = []
    if not hw:
        return out
    for inp in sorted(glob.glob(f"{hw}/temp*_input"), key=lambda p: int(re.search(r"temp(\d+)_", p).group(1))):
        t = readint(inp)
        if t is not None:
            out.append((readf(inp.replace("_input", "_label")) or os.path.basename(inp), t / 1000))
    return out


def split_cpu_temps(temps):
    """Split the main temperature (Package / Tctl) from the others (cores / CCDs)."""
    main = None
    for i, (n, _) in enumerate(temps):
        if n.startswith("Package") or n in ("Tctl", "Tdie"):
            main = temps.pop(i)[1]
            break
    if main is None and temps:
        main = max(t for _, t in temps)
    return main, temps


def read_cpu_stat():
    v = list(map(int, (readf("/proc/stat") or "cpu 0 0 0 0 0").splitlines()[0].split()[1:]))
    return sum(v), v[3] + (v[4] if len(v) > 4 else 0)


def read_cpu_freq():
    fs = [readint(p) for p in glob.glob("/sys/devices/system/cpu/cpu[0-9]*/cpufreq/scaling_cur_freq")]
    fs = [f for f in fs if f]
    return sum(fs) / len(fs) / 1000 if fs else None


def read_mem():
    m = {}
    for line in (readf("/proc/meminfo") or "").splitlines():
        k, v = line.split(":")
        m[k] = int(v.split()[0])
    total = m.get("MemTotal", 1) / 1048576
    return total - m.get("MemAvailable", 0) / 1048576, total


class IntelThrottle:
    """Kernel thermal throttling counters (Intel CPUs)."""

    def __init__(self):
        base = "/sys/devices/system/cpu/cpu[0-9]*/thermal_throttle/"
        self.counts = glob.glob(base + "*_throttle_count")
        self.times = glob.glob(base + "*_throttle_total_time_ms")
        self.prev = self._snap()

    def _snap(self):
        return {p: readint(p) or 0 for p in self.counts + self.times}

    def poll(self, interval):
        cur = self._snap()
        d = {p: cur[p] - self.prev.get(p, 0) for p in cur}
        self.prev = cur
        active = any(d[p] > 0 for p in self.counts) or any(d[p] > 0 for p in self.times)
        secs = max((d[p] for p in self.times), default=0) / 1000
        return active, (secs or interval) if active else 0


NV_BASE = "name,temperature.gpu,utilization.gpu,memory.used,memory.total,power.draw,power.limit,clocks.gr,fan.speed"


def nvidia_query():
    """Find which throttling fields the driver accepts (the name changed in newer drivers)."""
    for prefix in ("clocks_event_reasons", "clocks_throttle_reasons"):
        q = f"{NV_BASE},{prefix}.hw_thermal_slowdown,{prefix}.sw_thermal_slowdown"
        r = subprocess.run(["nvidia-smi", f"--query-gpu={q}", "--format=csv,noheader,nounits"],
                           capture_output=True, text=True, timeout=5)
        if r.returncode == 0 and r.stdout.strip():
            return q
    return NV_BASE


def read_nvidia(query):
    try:
        out = subprocess.run(["nvidia-smi", f"--query-gpu={query}", "--format=csv,noheader,nounits"],
                             capture_output=True, text=True, timeout=3).stdout.strip().splitlines()[0]
    except Exception:
        return None

    def num(s):
        try:
            return float(s)
        except ValueError:
            return None
    v = [x.strip() for x in out.split(",")]
    if len(v) < 9:
        return None
    g = dict(zip(["name", "temp", "util", "mem_used", "mem_total", "power", "plimit", "clock", "fan"],
                 [v[0].replace("NVIDIA ", "")] + [num(x) for x in v[1:9]]))
    g["throttle"] = any(x == "Active" for x in v[9:]) if len(v) > 9 else None
    return g


def find_amdgpu():
    """Pick the Radeon with the most VRAM (skips the integrated GPU when there is a discrete card)."""
    best = None
    for d in hwmons("amdgpu"):
        dev = os.path.realpath(f"{d}/device")
        vram = readint(f"{dev}/mem_info_vram_total") or 0
        if best is None or vram > best[0]:
            best = (vram, d, dev)
    return best[1:] if best else None


def read_amdgpu(hw, dev):
    def div(v, d):
        return v / d if v is not None else None
    pwm = readint(f"{hw}/pwm1")
    return {
        "name": readf(f"{dev}/product_name") or "AMD Radeon",
        "temp": div(readint(f"{hw}/temp1_input"), 1000),
        "util": readint(f"{dev}/gpu_busy_percent"),
        "mem_used": div(readint(f"{dev}/mem_info_vram_used"), 1048576),
        "mem_total": div(readint(f"{dev}/mem_info_vram_total"), 1048576),
        "power": div(readint(f"{hw}/power1_average") or readint(f"{hw}/power1_input"), 1e6),
        "plimit": div(readint(f"{hw}/power1_cap"), 1e6),
        "clock": div(readint(f"{hw}/freq1_input"), 1e6),
        "fan": pwm / 255 * 100 if pwm is not None else None,
        "throttle": None,
    }


def detect_gpu():
    if shutil.which("nvidia-smi"):
        try:
            q = nvidia_query()
            if read_nvidia(q):
                return lambda: read_nvidia(q)
        except Exception:
            pass
    amd = find_amdgpu()
    return (lambda: read_amdgpu(*amd)) if amd else None


def find_ssds():
    ssds = []
    for d in hwmons("nvme"):
        model = re.sub(r"\s+", " ", readf(f"{d}/device/model") or "NVMe").strip()
        lim = readint(f"{d}/temp1_max")
        ssds.append({"hw": d, "name": model, "limit": lim / 1000 if lim and lim < 200000 else None,
                     "stat": Stat(), "temp": None})
    return ssds


def fmt(v, unit="", nd=0):
    if v is None:
        return f"{GRAY}N/A{R}"
    return f"{v:,.{nd}f}" + unit


# ───────────────────────── screen layout ─────────────────────────
LBL, VAL, EXTRA = 8, 8, 9


def row(label, barstr, value, extra="", ew=EXTRA):
    return f"{GRAY}{label:<{LBL}}{R}{barstr} {pad(value, VAL)}{pad(extra, ew)}"


def bar_width(inner, ew=EXTRA):
    return max(8, inner - LBL - 1 - VAL - ew)


def temp_rows(stat, bw, kind):
    t = stat.hist[-1]
    return [row("Temp", bar(t, 100, bw, tcolor(kind)), f"{temp_color(t, kind)}{B}{t:.1f}°C{R}",
                f"{GRAY} max {stat.peak:.0f}°{R}"),
            row("", sparkline(stat.hist, bw, tcolor(kind)), "", f"{GRAY} avg {stat.avg:.0f}°{R}")]


def grid(items, inner):
    lines, colw = [], (inner - 2) // 2
    mb = max(4, colw - 13)
    cells = [f"{GRAY}{n:<7}{R}{bar(t, 100, mb, tcolor('cpu'))} {temp_color(t)}{t:3.0f}°{R}" for n, t in items]
    for i in range(0, len(cells), 2):
        pair = cells[i:i + 2]
        lines.append(pad(pair[0], colw) + ("  " + pair[1] if len(pair) > 1 else ""))
    return lines


def cpu_panel(w, st, cfg):
    inner = w - 4
    bw = bar_width(inner)
    L = [f"{DIM}{st['cpu_name']}{R}", st["cpu_thr"].line(), ""]
    if st["cpu_temp"] is not None:
        L += temp_rows(st["cpu_stat"], bw, "cpu")
    else:
        L.append(f"{C['hot']}Temperature sensor not found{R}")
    L.append(row("Load", bar(st["cpu_load"], 100, bw, load_color), f"{st['cpu_load']:.0f}%"))
    mu, mt = st["mem"]
    L.append(row("RAM", bar(100 * mu / mt, 100, bw, load_color), f"{mu:.1f} GB", f"{GRAY} of {mt:.0f} GB{R}"))
    L.append(f"{GRAY}{'Clock':<{LBL}}{R}{fmt(st['cpu_freq'], ' MHz')}")
    if st["cpu_cores"] and cfg["show"]["cores"]:
        L += [""] + grid(st["cpu_cores"], inner)
    return L


def gpu_panel(w, st):
    inner = w - 4
    bw = bar_width(inner)
    g = st["gpu"]
    if not g:
        return [f"{C['hot']}No NVIDIA or AMD GPU detected{R}"]
    L = [f"{DIM}{g['name']}{R}", st["gpu_thr"].line(), ""]
    if g["temp"] is not None:
        L += temp_rows(st["gpu_stat"], bw, "gpu")
    u = g["util"] or 0
    L.append(row("Load", bar(u, 100, bw, load_color), f"{u:.0f}%"))
    if g["mem_used"] is not None and g["mem_total"]:
        L.append(row("VRAM", bar(100 * g["mem_used"] / g["mem_total"], 100, bw, load_color),
                     f"{g['mem_used'] / 1024:.1f} GB", f"{GRAY} of {g['mem_total'] / 1024:.0f} GB{R}"))
    L.append(f"{GRAY}{'Clock':<{LBL}}{R}{pad(fmt(g['clock'], ' MHz'), 14)}  {GRAY}Fan{R} {fmt(g['fan'], '%')}")
    pw = fmt(g["power"], " W", 1) + (f"{GRAY} / {g['plimit']:.0f} W{R}" if g["plimit"] else "")
    L.append(f"{GRAY}{'Power':<{LBL}}{R}{pw}")
    return L


def ssd_panel(w, ssds):
    inner = w - 4
    ew = 18
    bw = bar_width(inner, ew)
    L = []
    for s in ssds:
        t, stat = s["temp"], s["stat"]
        lim = f"{GRAY}  ·  manufacturer limit {s['limit']:.0f}°C{R}" if s["limit"] else ""
        L.append(f"{DIM}{s['name']}{R}{lim}")
        if t is None:
            L.append(f"{GRAY}temperature unavailable{R}")
            continue
        L.append(row("Temp", bar(t, 100, bw, tcolor("ssd")), f"{temp_color(t, 'ssd')}{B}{t:.1f}°C{R}",
                     f"{GRAY} max {stat.peak:.0f}°  avg {stat.avg:.0f}°{R}", ew))
        if s["limit"] and t >= s["limit"]:
            L.append(f"{C['critical']}{B}▲ above limit: the SSD may be slowing down{R}")
    return L


def short_path(p):
    home = os.path.expanduser("~")
    return "~" + p[len(home):] if p.startswith(home) else p


def render(st, cfg, start, interval, log_path, warn):
    cols, rows_ = shutil.get_terminal_size((100, 30))
    up = int(time.time() - start)
    head = (f" {B}{C['title']}tempmon{R}  {GRAY}│{R}  {time.strftime('%H:%M:%S')}  {GRAY}│  session "
            f"{up // 3600:02d}:{up % 3600 // 60:02d}:{up % 60:02d}{R}")
    if warn:
        head += f"  {C['hot']}{warn}{R}"
    foot = f" {GRAY}q quit  ·  refresh every {interval:g}s{R}"
    if log_path:
        foot += f"  {GRAY}·{R}  {C['critical']}●{R} logging to {GRAY}{short_path(log_path)}{R}"

    show_ssd = cfg["show"]["ssd"] and st["ssds"]
    if cols >= 2 * 52 + 1:                       # side by side
        w = min(72, (cols - 1) // 2)
        a = panel("CPU", cpu_panel(w, st, cfg), w, C["cpu_border"])
        b = panel("GPU", gpu_panel(w, st), w, C["gpu_border"])
        h = max(len(a), len(b))
        for p, color in ((a, C["cpu_border"]), (b, C["gpu_border"])):   # equal heights
            while len(p) < h:
                p.insert(-1, f"{color}│{R}" + " " * (w - 2) + f"{color}│{R}")
        body = [x + " " + y for x, y in zip(a, b)]
        if show_ssd:
            body += panel("SSD", ssd_panel(2 * w + 1, st["ssds"]), 2 * w + 1, C["ssd_border"])
    else:                                        # stacked
        w = max(44, min(cols, 72))
        body = panel("CPU", cpu_panel(w, st, cfg), w, C["cpu_border"]) + panel("GPU", gpu_panel(w, st), w, C["gpu_border"])
        if show_ssd:
            body += panel("SSD", ssd_panel(w, st["ssds"]), w, C["ssd_border"])

    lines = [pad(head, cols), ""] + body + ["", pad(foot, cols)]
    return "\033[H" + "\n".join(l + "\033[K" for l in lines[:rows_]) + "\033[J"


# ───────────────────────── CSV log ─────────────────────────
def slug(s):
    return re.sub(r"[^a-z0-9]+", "_", s.lower()).strip("_")


class CsvLog:
    def __init__(self, path, ssds):
        os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
        self.path = path
        self.f = open(path, "w", newline="")
        self.w = csv.writer(self.f)
        self.w.writerow(["time", "cpu_temp_c", "cpu_load_pct", "cpu_clock_mhz", "ram_used_gb", "cpu_throttling",
                         "gpu_temp_c", "gpu_load_pct", "gpu_vram_gb", "gpu_clock_mhz", "gpu_fan_pct",
                         "gpu_power_w", "gpu_throttling"] + [f"ssd_{slug(s['name'])}_temp_c" for s in ssds])

    def write(self, st):
        def f(v, nd=1):
            return "" if v is None else f"{v:.{nd}f}"
        g = st["gpu"] or {}
        thr = lambda t: int(t.active) if t.available else ""
        self.w.writerow([datetime.now().isoformat(timespec="seconds"),
                         f(st["cpu_temp"]), f(st["cpu_load"]), f(st["cpu_freq"], 0), f(st["mem"][0], 2),
                         thr(st["cpu_thr"]),
                         f(g.get("temp")), f(g.get("util")),
                         f(g["mem_used"] / 1024 if g.get("mem_used") is not None else None, 2),
                         f(g.get("clock"), 0), f(g.get("fan"), 0), f(g.get("power")), thr(st["gpu_thr"])]
                        + [f(s["temp"]) for s in st["ssds"]])
        self.f.flush()

    def close(self):
        self.f.close()


# ───────────────────────── main loop ─────────────────────────
def parse_args():
    ap = argparse.ArgumentParser(prog="tempmon", description="CPU, GPU and SSD temperature monitor for the terminal.")
    ap.add_argument("interval", nargs="?", type=float, help="seconds between refreshes")
    ap.add_argument("--log", action="store_true", help="log the session to CSV in the configured folder")
    ap.add_argument("-o", "--output", metavar="FILE", help="log the session to CSV in this file")
    ap.add_argument("--config", action="store_true", help="print the config file path")
    ap.add_argument("--version", action="version", version=f"tempmon {VERSION}")
    args = ap.parse_args()
    if args.interval is not None and args.interval < 0.2:
        ap.error("the minimum interval is 0.2 seconds")
    return args


def main():
    args = parse_args()
    cfg, warn = load_config()
    if args.config:
        print(CONFIG_PATH)
        return
    setup(cfg)
    interval = args.interval or max(0.2, float(cfg["interval"]))

    cpu_hw = next(iter(hwmons("coretemp") + hwmons("k10temp") + hwmons("zenpower")), None)
    is_amd_cpu = bool(cpu_hw) and readf(f"{cpu_hw}/name") != "coretemp"
    intel_thr = IntelThrottle() if not is_amd_cpu else None
    gpu_reader = detect_gpu()
    st = {"cpu_name": cpu_name(), "cpu_stat": Stat(), "gpu_stat": Stat(),
          "cpu_thr": Throttle(), "gpu_thr": Throttle(), "ssds": find_ssds()}
    if intel_thr is not None and not intel_thr.counts:
        intel_thr = None

    log = None
    if args.log or args.output:
        path = args.output or os.path.join(os.path.expanduser(cfg["log"]["dir"]),
                                           datetime.now().strftime("tempmon_%Y-%m-%d_%H-%M-%S.csv"))
        try:
            log = CsvLog(os.path.abspath(os.path.expanduser(path)), st["ssds"])
        except OSError as e:
            sys.exit(f"tempmon: could not create log file {path}: {e.strerror}")

    fd = sys.stdin.fileno() if sys.stdin.isatty() else None
    old = None
    if fd is not None:
        import termios, tty
        old = termios.tcgetattr(fd)
        tty.setcbreak(fd)

    def wait(t):
        """Wait t seconds; return True if the user pressed q."""
        if fd is None:
            time.sleep(t)
            return False
        end = time.time() + t
        while (rem := end - time.time()) > 0:
            if select.select([sys.stdin], [], [], rem)[0] and os.read(fd, 1) in (b"q", b"Q"):
                return True
        return False

    start = last = time.time()
    prev = read_cpu_stat()
    sys.stdout.write("\033[?1049h\033[?25l\033[2J")
    try:
        time.sleep(0.3)
        while True:
            now = time.time()
            dt_s, last = now - last, now
            cur = read_cpu_stat()
            dt, di = cur[0] - prev[0], cur[1] - prev[1]
            prev = cur
            st["cpu_load"] = 100 * (dt - di) / dt if dt else 0
            st["cpu_temp"], st["cpu_cores"] = split_cpu_temps(read_cpu_temps(cpu_hw))
            st["cpu_freq"] = read_cpu_freq()
            st["mem"] = read_mem()
            st["gpu"] = (gpu_reader() or st.get("gpu")) if gpu_reader else None
            st["cpu_stat"].add(st["cpu_temp"])

            if intel_thr:
                st["cpu_thr"].update(*intel_thr.poll(dt_s))
            elif is_amd_cpu and st["cpu_temp"] is not None:
                st["cpu_thr"].update(st["cpu_temp"] >= LIM["cpu_amd_limit"], dt_s)
            else:
                st["cpu_thr"].update(None, 0)

            if st["gpu"]:
                st["gpu_stat"].add(st["gpu"]["temp"])
                st["gpu_thr"].update(st["gpu"]["throttle"], dt_s)
            for s in st["ssds"]:
                t = readint(f"{s['hw']}/temp1_input")
                s["temp"] = t / 1000 if t is not None else None
                s["stat"].add(s["temp"])

            if log:
                log.write(st)
            sys.stdout.write(render(st, cfg, start, interval, log.path if log else None, warn))
            sys.stdout.flush()
            if wait(interval):
                break
    except KeyboardInterrupt:
        pass
    finally:
        if old is not None:
            termios.tcsetattr(fd, termios.TCSADRAIN, old)
        sys.stdout.write("\033[?25h\033[?1049l")
        sys.stdout.flush()
        up = int(time.time() - start)
        print(f"Session summary ({up // 3600:02d}:{up % 3600 // 60:02d}:{up % 60:02d})")

        def line(name, stat, thr=None):
            if stat.n:
                s = f"  {name:<22} max {stat.peak:5.1f}°C   avg {stat.avg:5.1f}°C"
                print(s + (f"   throttling: {thr.summary()}" if thr else ""))
        line("CPU", st["cpu_stat"], st["cpu_thr"])
        line("GPU", st["gpu_stat"], st["gpu_thr"])
        for s in st["ssds"]:
            line("SSD " + s["name"][:18], s["stat"])
        if log:
            log.close()
            print(f"Log saved to: {log.path}")


if __name__ == "__main__":
    main()
